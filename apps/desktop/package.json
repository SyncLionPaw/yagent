{
  "name": "yagent-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "yagent desktop shell (Electron)",
  "main": "dist/main.js",
  "dependencies": {
    "@yagent/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "concurrently -k -n web,electron \"pnpm --dir ../web dev\" \"wait-on http://localhost:5173 && pnpm build && VITE_DEV_SERVER_URL=http://localhost:5173 electron . -- --dev\"",
    "start": "electron .",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder"
  },
  "build": {
    "appId": "com.yagent.app",
    "productName": "yagent",
    "files": [
      "dist/**/*",
      "package.json",
      {
        "from": "../web/dist",
        "to": "web-dist"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage", "deb"]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SyncLionPaw",
        "repo": "yagent"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "wait-on": "^9.5.1"
  }
}
